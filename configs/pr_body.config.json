{
  "validation": {
    "steps": [
      {
        "id": 1,
        "preId": 0,
        "step": "Required Sections",
        "regex": {
          "pattern": "^\\[TYPE\\].*[\\s\\S]*?^\\[DESCRIPTION\\].*[\\s\\S]*?^\\[IREF\\]",
          "flags": "m"
        },
        "error": "Missing or incorrectly ordered required sections: [TYPE], [DESCRIPTION], [IREF]."
      },
      {
        "id": 2,
        "preId": 1,
        "step": "Valid Type",
        "regex": {
          "pattern": "^\\[TYPE\\] (?:mod-workflow|add-media|mod-metadata|mod-doc)\\b[^\\r\\n]*(?:(?!^\\[[A-Z]+\\]).)*",
          "flags": "ms"
        },
        "error": "The [TYPE] section must contain one of the valid types: mod-workflow, add-media, mod-metadata, or mod-doc."
      },
      {
        "id": 3,
        "preId": 1,
        "step": "Non-Empty Description",
        "regex": {
          "pattern": "^\\[DESCRIPTION\\][^\\S\\r\\n]*(?:\\r?\\n)?\\s*\\S(?:(?!^\\[[A-Z]+\\]).)*",
          "flags": "ms"
        },
        "error": "The [DESCRIPTION] section must not be empty. Fill `-` as content if intended empty."
      },
      {
        "id": 4,
        "preId": 1,
        "step": "Valid Issue Reference",
        "regex": {
          "pattern": "^\\[IREF\\] (?:(?!^\\[[A-Z]+\\]).)*?(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\\s+#\\d+(?:(?!^\\[[A-Z]+\\]).)*",
          "flags": "ms"
        },
        "error": "The [IREF] section must contain a valid issue reference, such as 'fix #123', 'closes #123', or 'resolved #123', before the next section header."
      }
    ]
  },
  "getTypeRegex": {
    "pattern": "(?<=^\\[TYPE\\] )(?:mod-workflow|add-media|mod-metadata|mod-doc)\\b",
    "flags": ""
  }
}